{
  "name": "sinch-ai-bot-webhook",
  "version": "1.0.0",
  "description": "Receives Sinch AI bot call-log webhooks, queues them with BullMQ, and delivers CSV reports to SFTP",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --import ./tests/setup.ts --test tests/*.test.ts",
    "test:unit": "npm test",
    "test:integration": "tsx --import ./tests/setup.ts --import ./tests/setupRedis.ts --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:api": "tsx --import ./tests/setup.ts --import ./tests/setupRedis.ts --test --test-concurrency=1 tests/api/*.test.ts",
    "test:webhook": "tsx --import ./tests/setup.ts --import ./tests/setupRedis.ts --test --test-concurrency=1 tests/webhook/*.test.ts",
    "test:security": "tsx --import ./tests/setup.ts --import ./tests/setupRedis.ts --test --test-concurrency=1 tests/security/*.test.ts",
    "test:e2e": "tsx --import ./tests/setup.ts --import ./tests/setupRedis.ts --test --test-concurrency=1 tests/e2e/*.test.ts",
    "test:reliability": "tsx --import ./tests/setup.ts --import ./tests/setupRedis.ts --test --test-concurrency=1 tests/reliability/*.test.ts",
    "test:regression": "tsx --import ./tests/setup.ts --import ./tests/setupRedis.ts --test --test-concurrency=1 tests/regression/*.test.ts",
    "test:performance": "tsx --import ./tests/setup.ts --import ./tests/setupRedis.ts --test --test-concurrency=1 tests/performance/*.test.ts",
    "test:redis": "tsx --import ./tests/setup.ts --import ./tests/setupRedis.ts --test --test-concurrency=1 tests/integration/*.test.ts tests/api/*.test.ts tests/webhook/*.test.ts tests/security/*.test.ts tests/e2e/*.test.ts tests/reliability/*.test.ts tests/regression/*.test.ts",
    "test:all": "npm test && npm run test:redis && npm run test:performance",
    "test:redis:up": "docker run -d --rm --name sinch_ai_bot_webhook_redis_test -p 127.0.0.1:4998:6379 --tmpfs /data redis:7.2-alpine redis-server --save \"\" --appendonly no && node -e \"setTimeout(()=>{},2000)\"",
    "test:redis:down": "docker rm -f sinch_ai_bot_webhook_redis_test",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint src",
    "format": "prettier --write src",
    "audit:check": "npm audit --audit-level=high",
    "all": "npm install && npm run audit:check && npm run format && npm run lint && npm run test:redis:up && npm run test:all && npm run build"
  },
  "keywords": [
    "sinch",
    "webhook",
    "bullmq",
    "redis",
    "sftp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1023.0",
    "@bull-board/api": "^9.10.5",
    "@bull-board/express": "^9.10.5",
    "bullmq": "^5.7.4",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "ssh2-sftp-client": "^10.0.3",
    "winston": "^3.19.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "eslint": "^10.8.0",
    "prettier": "^3.1.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.58.0"
  }
}
