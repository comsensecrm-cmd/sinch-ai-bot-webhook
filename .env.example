# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Redis
REDIS_URL=redis://localhost:4001
REDIS_PASSWORD=

# Bull Board (queue dashboard). Defaults to on outside production, off in production.
BULL_BOARD_ENABLED=true
BULL_BOARD_PATH=/admin/queues

# Queue
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY_MS=2000

# CSV
CSV_OUTPUT_DIR=./csv_output
CSV_FLUSH_INTERVAL_MINUTES=30
CSV_FLUSH_TIMEZONE=Asia/Kolkata

# SFTP
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_REMOTE_DIR=/import
SFTP_FAILURE_REMOTE_DIR=
SFTP_DLQ_REMOTE_DIR=
SFTP_MAX_RETRIES=5
SFTP_RETRY_DELAY_MS=2000
SFTP_FAILED_RETRY_INTERVAL_MS=300000

# Logging
LOG_LEVEL=info

# AWS CloudWatch
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_LOG_GROUP=
AWS_LOG_STREAM=sinch-ai-bot-webhook-log-stream

# Reprocessing: records per queue batch
REPROCESS_BATCH_SIZE=500
